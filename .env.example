# Same-origin path. Next.js rewrites /api/v1 to the CivicFix backend.
# Use this in production so the browser does not hit CORS.
NEXT_PUBLIC_API_URL=/api/v1

# Optional override for the rewrite target (server-only).
# CIVICFIX_API_PROXY_TARGET=https://civicfix-backend-nine.vercel.app/api/v1

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
